generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  FIXED
  VARIABLE
}

enum LoanType {
  RECEIVABLE
  PAYABLE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  categories Category[]
  budgets    Budget[]
  expenses   Expense[]
  loans      Loan[]
  people     Person[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Category {
  id     String       @id @default(cuid())
  name   String
  type   CategoryType
  userId String

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets  Budget[]
  expenses Expense[]

  @@index([userId])
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  month       String
  amount      Float
  isRecurring Boolean  @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, month])
  @@unique([userId, categoryId, month])
}

model Expense {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Float
  date       DateTime
  note       String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  splits   ExpenseSplit[]

  @@index([userId, date])
}

model ExpenseSplit {
  id        String @id @default(cuid())
  expenseId String
  personId  String
  amount    Float

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model Person {
  id      String  @id @default(cuid())
  userId  String
  name    String
  contact String?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  splits ExpenseSplit[]
  loans  Loan[]

  @@index([userId])
}

model Loan {
  id          String   @id @default(cuid())
  userId      String
  personId    String
  type        LoanType
  totalAmount Float

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  person       Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  transactions LoanTransaction[]

  @@index([userId])
}

model LoanTransaction {
  id     String   @id @default(cuid())
  loanId String
  amount Float
  date   DateTime
  note   String?

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
}
