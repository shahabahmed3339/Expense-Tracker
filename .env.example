# Local Postgres (manual install): set user/password/db to match your instance
# DATABASE_URL="postgresql://expense_app:your_secure_password@localhost:5432/expense_tracker?schema=public"

# Docker: copy this after `docker compose up -d` (password matches docker-compose.yml)
DATABASE_URL="postgresql://expense_app:expense_local_dev@localhost:5432/expense_tracker?schema=public"

# App/auth
PORT=3000
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32-min-32-chars"
NEXT_PUBLIC_APP_NAME="Expense Tracker"
NEXT_PUBLIC_APP_HOST="localhost"

# Auth runtime config
AUTH_PASSWORD_HASH_ROUNDS=12
AUTH_OTP_HASH_ROUNDS=10
AUTH_OTP_EXPIRY_MINUTES=2
AUTH_VERIFICATION_EXPIRY_HOURS=24

# Auth rate limiting
RATE_LIMIT_REGISTER_IP_LIMIT=8
RATE_LIMIT_REGISTER_IP_WINDOW_MS=900000
RATE_LIMIT_REGISTER_EMAIL_LIMIT=4
RATE_LIMIT_REGISTER_EMAIL_WINDOW_MS=900000
RATE_LIMIT_LOGIN_START_IP_LIMIT=12
RATE_LIMIT_LOGIN_START_IP_WINDOW_MS=900000
RATE_LIMIT_LOGIN_START_EMAIL_LIMIT=6
RATE_LIMIT_LOGIN_START_EMAIL_WINDOW_MS=600000
RATE_LIMIT_LOGIN_RESEND_IP_LIMIT=10
RATE_LIMIT_LOGIN_RESEND_IP_WINDOW_MS=900000
RATE_LIMIT_LOGIN_RESEND_CHALLENGE_LIMIT=3
RATE_LIMIT_LOGIN_RESEND_CHALLENGE_WINDOW_MS=120000
RATE_LIMIT_VERIFY_RESEND_IP_LIMIT=8
RATE_LIMIT_VERIFY_RESEND_IP_WINDOW_MS=900000
RATE_LIMIT_VERIFY_RESEND_EMAIL_LIMIT=3
RATE_LIMIT_VERIFY_RESEND_EMAIL_WINDOW_MS=900000
RATE_LIMIT_VERIFY_EMAIL_IP_LIMIT=20
RATE_LIMIT_VERIFY_EMAIL_IP_WINDOW_MS=900000
EMAIL_LOGO_CID="expense-tracker-logo"

# # Optional: Google OAuth (set both; duplicate client id below to show the button in the UI)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Legacy names also supported by authOptions:
# GOOGLE_ID=
# GOOGLE_SECRET=

# Optional: email delivery for signup verification, email change verification, and login OTP.
# If these are not set, the app falls back to logging email payloads in the server console for local dev.
EMAIL_PROVIDER="auto"

# Gmail SMTP
EMAIL_FROM="Expense Tracker <you@yourdomain.com>"
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# # Resend SMTP
# EMAIL_FROM="Expense Tracker <you@yourdomain.com>"
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=465
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=true
# RESEND_API_KEY="your_smtp_password"

# # Gmail API
# GMAIL_CLIENT_EMAIL=you@yourdomain.com
# GMAIL_PRIVATE_KEY=your_private_key
# GMAIL_PROJECT_ID=your_project_id

# Upstash Redis (required in production for distributed rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile (optional bot protection)
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Vercel Blob (recommended for profile avatars in production)
BLOB_READ_WRITE_TOKEN=""

# Sentry (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Cron job authentication (required in production)
CRON_SECRET=""

# Set to true to skip env validation during local tooling
# SKIP_ENV_VALIDATION=true