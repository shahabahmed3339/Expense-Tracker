# Local Postgres (manual install): set user/password/db to match your instance
# DATABASE_URL="postgresql://expense_app:your_secure_password@localhost:5432/expense_tracker?schema=public"

# Docker: copy this after `docker compose up -d` (password matches docker-compose.yml)
DATABASE_URL="postgresql://expense_app:expense_local_dev@localhost:5432/expense_tracker?schema=public"

# App/auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional: Google OAuth (set both; duplicate client id below to show the button in the UI)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Legacy names also supported by authOptions:
# GOOGLE_ID=
# GOOGLE_SECRET=

# Optional: email delivery for signup verification, email change verification, and login OTP.
# If these are not set, the app falls back to logging email payloads in the server console for local dev.
EMAIL_FROM="Expense Tracker <no-reply@example.com>"
RESEND_API_KEY=""
